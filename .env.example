# ==============================================================================
# SafeSphere - Environment Configuration Template
# Copy this file to .env in backend/ and frontend/ or root as needed.
# NEVER commit real credentials or .env files to version control.
# ==============================================================================

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://safesphere_user:safesphere_password@localhost:5432/safesphere_db

# Google Gemini AI API Configuration (Step 7: Safety Intelligence & Step 8: Multi-modal)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Multi-modal Storage & Upload Limits (Step 8)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1

# Firebase Authentication & Cloud Messaging Configuration (Public Web Client)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=safesphere-app.firebaseapp.com
FIREBASE_PROJECT_ID=safesphere-app
FIREBASE_STORAGE_BUCKET=safesphere-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Firebase Admin SDK (Backend Credentials Path - Optional for initial dev)
FIREBASE_CREDENTIALS_PATH=

# Guardian Verification & Real SMS Notification Provider Configuration
# Supported SMS providers: "twilio", "msg91", "dev"
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER=
SMS_PROVIDER_ACCOUNT_SID=
SMS_PROVIDER_AUTH_TOKEN=
SMS_PROVIDER_FROM_NUMBER=
SMS_PROVIDER_SERVICE_ID=
SMS_PROVIDER_TEMPLATE_ID=

# Guardian Verification & Real Email Notification Provider Configuration
# Supported Email providers: "smtp", "resend", "sendgrid", "dev"
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@safesphere.app
EMAIL_FROM_NAME=SafeSphere Verification

# SMTP Specific Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Guardian Connect Contact Verification (OTP Removed / Deprecated)
# Guardian contact management now directly saves details with status NOT_VERIFIED.
# The following OTP settings are retained for legacy/deprecated endpoints only:
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DEV_MODE=false
OTP_DEV_CODE=123456

# Safety-Aware Routing Engine Configuration (Step 10)
# Providers: osrm (default open-source demo), google, openrouteservice
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_API_KEY=
ROUTING_TIMEOUT_SECONDS=15.0

# Google Maps Platform Configuration (Professional Navigation Upgrade)
# Frontend (Browser - Restrict with HTTP referrer restrictions):
VITE_GOOGLE_MAPS_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# Backend (Server-side - Keep strictly confidential, restrict with IP restrictions):
GOOGLE_MAPS_ROUTES_API_KEY=

