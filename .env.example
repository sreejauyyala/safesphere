# ==============================================================================
# SafeSphere - Environment Configuration Template
# Copy this file to .env in backend/ and frontend/ or root as needed.
# NEVER commit real credentials or .env files to version control.
# ==============================================================================

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://safesphere_user:safesphere_password@localhost:5432/safesphere_db

# Google Gemini AI API Key (Required for Step 8: Safety intelligence, text/voice/image analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1

# Firebase Authentication & Cloud Messaging Configuration (Public Web Client)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=safesphere-app.firebaseapp.com
FIREBASE_PROJECT_ID=safesphere-app
FIREBASE_STORAGE_BUCKET=safesphere-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Firebase Admin SDK (Backend Credentials Path - Optional for initial dev)
FIREBASE_CREDENTIALS_PATH=
