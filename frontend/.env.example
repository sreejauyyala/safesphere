# SafeSphere Frontend Environment Configuration
VITE_API_URL=http://localhost:8000/api/v1

# Firebase Web Client Public Configuration
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=safesphere-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=safesphere-app
VITE_FIREBASE_STORAGE_BUCKET=safesphere-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Map & Tile Provider Defaults
VITE_DEFAULT_MAP_LAT=12.9716
VITE_DEFAULT_MAP_LNG=77.5946
VITE_DEFAULT_MAP_ZOOM=14
